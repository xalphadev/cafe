# ── Database URL (ใช้ชื่อ service "db" เป็น host ใน Docker) ──────────────────
DATABASE_URL=postgresql://postgres:Caf3@Secret2026!@db:5432/cafe_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=ch4ngwel4k4f3s3cr3tk3y2026xalpha!!
