# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.production and fill in real values.
# DO NOT commit .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=cafe_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Caf3@Secret2026!

# ── Database URL (ใช้ชื่อ service "db" เป็น host ใน Docker) ──────────────────
DATABASE_URL=postgresql://postgres:Caf3@Secret2026!@db:5432/cafe_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=ch4ngwel4k4f3s3cr3tk3y2026xalpha!!
JWT_EXPIRES_IN=7d

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://coffee.xalpha.co.th
NEXT_PUBLIC_APP_NAME=ช่วงเวลาคาเฟ่

# ── SMS (ใส่ค่าจริงถ้าใช้ OTP จริง) ──────────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_FROM=

# ── ที่เก็บไฟล์อัปโหลด (สลิป / รูปสินค้า) — เลือกอย่างใดอย่างหนึ่ง ─────────────────
#
# แบบ A: MinIO ใน Docker (โปรเจกต์นี้ — ไม่ชนโปรเจกต์อื่นเพราะใช้ container cafe_minio + volume cafe_minio_data)
#   รัน: docker compose --profile minio up -d
#   แอปคุยกับ MinIO ผ่าน network ภายใน: host = ชื่อ service คือ minio
#
MINIO_ROOT_USER=cafeminio
MINIO_ROOT_PASSWORD=set-strong-password-here
#
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=cafeminio
S3_SECRET_KEY=set-strong-password-here
S3_BUCKET=cafe-shop
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# URL ที่เบราว์เซอร์และแอดมินเปิดดูรูปได้ (ต้องชี้ reverse proxy ไปที่ MinIO + ตั้ง bucket เป็นอ่านสาธารณะหรือ policy ให้โหลด object ได้)
# ตัวอย่าง path-style: https://files.โดเมนของคุณ/cafe-shop  (แล้ว object จะเป็น .../cafe-shop/payment-slips/...)
# ถ้า proxy แมป root ไปที่ bucket อย่างเดียว ให้ตั้ง S3_PUBLIC_BASE_URL=https://files.โดเมนของคุณ
S3_PUBLIC_BASE_URL=https://coffee.xalpha.co.th/เปลี่ยนเป็น-path-จริง
#
# โหลดรูปผ่าน next/image: ใส่ hostname ของ URL ด้านบน (คั่นด้วย comma ถ้าหลายตัว)
# NEXT_PUBLIC_UPLOAD_IMAGE_HOSTNAME=files.coffee.xalpha.co.th
#
# หลัง MinIO ขึ้นแล้ว เปิดนโยบายให้อ่าน object (ตัวอย่างด้วย mc จากเครื่องคุณ):
#   mc alias set cafe https://files... cafeminio 'รหัส'
#   mc mb --ignore-existing cafe/cafe-shop
#   mc anonymous set download cafe/cafe-shop
#
# แบบ B: Cloudinary (ไม่ใช้ MinIO)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── PromptPay ─────────────────────────────────────────────────────────────────
PROMPTPAY_ID=0812345678

# ── LINE Messaging API (LINE OA) ──────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── LINE Login (OAuth2 เชื่อมบัญชี) ──────────────────────────────────────────
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ── LIFF App ID ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_LIFF_ID=

# ── Master OTP (รหัสลับสำหรับ bypass OTP ตอน test / แก้ปัญหา) ───────────────
MASTER_OTP=919999

# ── Web Push (VAPID) ── ฟรี 100% ─────────────────────────────────────────────
# สร้าง key ใหม่ด้วย: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourshop.com
