# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.production and fill in real values.
# DO NOT commit .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=cafe_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── App (DATABASE_URL is auto-built in docker-compose from the vars above) ───
# If running outside Docker, set this manually:
# DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cafe_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_at_least_32_random_chars_here
JWT_EXPIRES_IN=7d

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://cafe.xalpha.co.th
NEXT_PUBLIC_APP_NAME=ช่วงเวลาคาเฟ่

# ── SMS (ใส่ค่าจริงถ้าใช้ OTP จริง) ──────────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_FROM=

# ── Cloudinary (สำหรับอัพโหลดรูปสินค้า) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── PromptPay ─────────────────────────────────────────────────────────────────
PROMPTPAY_ID=0812345678

# ── LINE Notify (ถ้าใช้) ──────────────────────────────────────────────────────
LINE_NOTIFY_TOKEN=
