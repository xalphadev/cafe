# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.production and fill in real values.
# DO NOT commit .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=cafe_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Caf3@Secret2026!

# ── Database URL (ใช้ชื่อ service "db" เป็น host ใน Docker) ──────────────────
DATABASE_URL=postgresql://postgres:Caf3@Secret2026!@db:5432/cafe_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=ch4ngwel4k4f3s3cr3tk3y2026xalpha!!
JWT_EXPIRES_IN=7d

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://coffee.xalpha.co.th
NEXT_PUBLIC_APP_NAME=ช่วงเวลาคาเฟ่

# ── MinIO (S3-compatible) — self-hosted, ฟรี 100% ────────────────────────────
# รัน: docker compose --profile minio up -d
# bucket จะถูกสร้างและเปิด public read อัตโนมัติโดย minio-init container
#
MINIO_ROOT_USER=cafeminio
MINIO_ROOT_PASSWORD=set-strong-password-here
#
# แอปคุยกับ MinIO ผ่าน Docker network (ใช้ชื่อ service "minio")
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=cafeminio
S3_SECRET_KEY=set-strong-password-here    # ต้องตรงกับ MINIO_ROOT_PASSWORD
S3_BUCKET=shop
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
#
# URL สาธารณะที่เบราว์เซอร์ใช้โหลดรูป (ผ่าน Caddy reverse proxy)
# Caddyfile: storage.yourdomain.com { reverse_proxy cafe_minio:9000 }
S3_PUBLIC_BASE_URL=https://storage.coffee.xalpha.co.th/shop
#
# hostname ที่ next/image อนุญาต (ตรงกับ S3_PUBLIC_BASE_URL)
NEXT_PUBLIC_UPLOAD_IMAGE_HOSTNAME=storage.coffee.xalpha.co.th

# ── PromptPay ─────────────────────────────────────────────────────────────────
PROMPTPAY_ID=0812345678

# ── LINE Login (OAuth2 เชื่อมบัญชี + LIFF) ───────────────────────────────────
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
NEXT_PUBLIC_LIFF_ID=

# ── LINE Messaging API ────────────────────────────────────────────────────────
# ใช้สำหรับ webhook รับข้อความ (LINE Login callback) เท่านั้น
# push message ถูกปิดแล้ว — แจ้งเตือนใช้ Web Push แทน
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── Web Push (VAPID) — ฟรี 100% ──────────────────────────────────────────────
# สร้าง key ใหม่: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourshop.com

# ── Master OTP (bypass OTP ตอน test) ─────────────────────────────────────────
MASTER_OTP=919999

# ── SMS (ไม่ได้ใช้งาน — mock เท่านั้น) ───────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_FROM=
